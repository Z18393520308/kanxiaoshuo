<Window x:Class="摸鱼联盟.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:摸鱼联盟"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        WindowStyle="None"
        BorderBrush="#8C8C8C"
        BorderThickness="3"

        Title="努力搬砖,早日实现第一个百年计划！" Height="430" Width="600" Icon="/images/鱼.png" MouseDown="Window_MouseDown">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border Background="White" CornerRadius="15" Opacity="1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#FFFFFF">
            <Image Source="/images/5a08fdf0293d32790b86da49cbce165a.jpeg"> </Image>
        </Grid>

        <Grid Grid.Column="1" Background="#F1F0F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"></RowDefinition>
                <RowDefinition Height="35"></RowDefinition>
                <RowDefinition Height="35"></RowDefinition>
                <RowDefinition Height="35"></RowDefinition>
                <RowDefinition Height="35"></RowDefinition>
                <RowDefinition Height="35"></RowDefinition>
                <RowDefinition Height="90"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>

            <Border Width="270" Height="25" Background="White" CornerRadius="2" Margin="0,0,0,0">
                <TextBlock Grid.Row="0" Text="配置" FontSize="11" Foreground="#939393" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0" ></TextBlock>
            </Border>
            
            <Border Grid.Row="1" Width="270" Height="25" Background="White" CornerRadius="2" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="55"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="选择txt" FontSize="11" Foreground="#939393"></Label>
                    <TextBox x:Name="txt_Reading" Grid.Column="1" Text="{Binding FileNmae}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0" Width="150" Height="20" FontSize="12" IsEnabled="False"></TextBox>
                    <Border Grid.Column="2" CornerRadius="2" VerticalAlignment="Center" BorderBrush="#1890FF" BorderThickness="1"  Width="50" Height="20" Background="#1890FF">
                        <Button x:Name="btn_Path_Select" Margin="1" Background="#1890FF" Content="选择" Foreground="White" BorderThickness="0" Command="{Binding btn_Path_Select}" CommandParameter="{Binding ElementName=btn_Path_Select}"></Button>
                    </Border>

                </Grid>



            </Border>

            <Border Grid.Row="2" Width="270" Height="25" Background="White" CornerRadius="2" Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"  HorizontalAlignment="Left" VerticalAlignment="Center" Content="字体设置" FontSize="11" Foreground="#939393"></Label>
                    <Label Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{Binding FontSize}" Content="这是你选择的字体的颜色和尺寸的预览" Foreground="{Binding Foreground}"></Label>
                </Grid>

            </Border>

            <Border Grid.Row="3" Width="270" Height="25" Background="White" CornerRadius="2" Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="尺寸" FontSize="11" Foreground="#939393"></Label>
                    <Slider Grid.Column="1" HorizontalAlignment="Left" Margin="0,5,0,0" Grid.Row="3" VerticalAlignment="Top" Width="210" Value="{Binding FontSize}" Grid.RowSpan="2" Maximum="15" Minimum="3"/>
                </Grid>

            </Border>

            <Border Grid.Row="4" Width="270" Height="25" Background="White" CornerRadius="2" Margin="0,0,0,0">
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>

                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="字体颜色" FontSize="11" Foreground="#939393"></Label>

                    <Border BorderThickness="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="1" CornerRadius="20" Width="22" Height="22" BorderBrush="#939393">
                        <Button Width="15" Height="15" Background="Transparent" BorderThickness="0" Command="{Binding btn_Color1}"></Button>
                    </Border>
                    <Border BorderThickness="1" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="2" CornerRadius="20" Width="22" Height="22" BorderBrush="#939393">
                        <Button Width="15" Height="15" Background="Transparent" BorderThickness="0" Command="{Binding btn_Color2}"></Button>
                    </Border>
                    <Border BorderThickness="1" Background="#9DE5FE" HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="3" CornerRadius="20" Width="22" Height="22">
                        <Button Width="15" Height="15" Background="Transparent" BorderThickness="0" Command="{Binding btn_Color3}"></Button>
                    </Border>
                    <Border BorderThickness="1" Background="#FCEABA" HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="4" CornerRadius="20" Width="22" Height="22">
                        <Button Width="15" Height="15" Background="Transparent" BorderThickness="0" Command="{Binding btn_Color4}"></Button>
                    </Border>
                    <Border BorderThickness="1" Background="#D0EABB" HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="5" CornerRadius="20" Width="22" Height="22">
                        <Button Width="15" Height="15" Background="Transparent" BorderThickness="0" Command="{Binding btn_Color5}"></Button>
                    </Border>

                    <Border BorderThickness="1" Grid.Column="6" CornerRadius="20" Width="22" Height="22" BorderBrush="Transparent">
                        <Image Source="/images/色环.png" Width="21" Height="21"></Image>
                    </Border>

                </Grid>

            </Border>

            <Border Grid.Row="5" Width="270" Height="25" Background="White" CornerRadius="2" Margin="0,0,0,0">
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>

                     </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="字体" FontSize="11" Foreground="#939393"></Label>

                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="#EBEBEB" Margin="0,0,10,0" Height="20" Width="200" CornerRadius="2">
                        <ComboBox Height="20" Width="200" BorderThickness="0" ></ComboBox>
                    </Border>
                   

                </Grid>

            </Border>



            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"></RowDefinition>

                    <RowDefinition></RowDefinition>


                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Content="快捷键设置" Margin="15,0,0,0" FontSize="6" Foreground="#939393"></Label>
                <Border Grid.Row="5" Width="270" Height="60" Background="White" CornerRadius="2" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"></ColumnDefinition>
                            <ColumnDefinition Width="40"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="40"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Grid.Row="0" Content="翻页" VerticalAlignment="Center" FontSize="11" Foreground="#939393"></Label>
                        <Label Grid.Column="1" Grid.Row="0" Margin="0,0,0,0" VerticalAlignment="Center" Content="向上:" FontSize="11" Foreground="#939393"></Label>
                        <TextBox Grid.Column="2" Grid.Row="0" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" FontSize="11" Foreground="#939393">Up</TextBox>

                        <Label Grid.Column="3" Grid.Row="0" HorizontalContentAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" Content="向下:" FontSize="11" Foreground="#939393"></Label>
                        <TextBox Grid.Column="4" Grid.Row="0" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" FontSize="11" Foreground="#939393">Down</TextBox>


                        <Label Grid.Column="0" Grid.Row="1" Content="控制" FontSize="11" VerticalAlignment="Center" Foreground="#939393"></Label>
                        <Label Grid.Column="1" Grid.Row="1" Margin="0,0,0,0" Content="隐藏:" VerticalAlignment="Center" FontSize="11" Foreground="#939393"></Label>
                        <TextBox Grid.Column="2" Grid.Row="1" Width="60" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" FontSize="11" Foreground="#939393">Alt+C</TextBox>

                        <Label Grid.Column="3" Grid.Row="1" HorizontalContentAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Center" Content="显示:" FontSize="11" Foreground="#939393"></Label>
                        <TextBox Grid.Column="4" Grid.Row="1" Width="60" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" FontSize="11" Foreground="#939393">Alt+S</TextBox>
                 </Grid>
                    
                </Border>
              

                

               
            </Grid>

            <Border Grid.Row="7" CornerRadius="5" Height="25" Width="270" Background="#1890FF">
                <Button Content="保存配置" Margin="2" Background="#1890FF" Foreground="White" Click="Button_Click" BorderThickness="0"></Button>
            </Border>
        </Grid>



    </Grid>
</Window>
